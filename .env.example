# Copy to .env. Reference photos and keys never belong in Git.
STYLEMAX_DATA_DIR=data
STYLEMAX_FRONTEND_DIR=frontend/dist
STYLEMAX_SECURE_COOKIES=false

# Run Ollama separately and pull this model. No paid account required.
STYLEMAX_OLLAMA_URL=http://127.0.0.1:11434
STYLEMAX_OLLAMA_MODEL=qwen2.5:7b

# A separately launched local/remote CUDA worker. Leave blank for demo-only images.
STYLEMAX_IMAGE_WORKER_URL=
STYLEMAX_IMAGE_WORKER_KEY=
STYLEMAX_IMAGE_TIMEOUT=600

# Official eBay developer application credentials (server-side only).
STYLEMAX_EBAY_CLIENT_ID=
STYLEMAX_EBAY_CLIENT_SECRET=

# Optional, unofficial community clients; install the marketplaces extra first.
STYLEMAX_ENABLE_KLEINANZEIGEN=false
STYLEMAX_ENABLE_VINTED=false
STYLEMAX_MARKETPLACE_TIMEOUT=20
